#!/usr/bin/env sh
# Git runs this hook when core.hooksPath is .husky (`husky install` sets it once
# per clone). The hook does not need the .husky/_ files, so it also runs in a new
# worktree. Without node_modules, commitlint is skipped with a warning. CI
# lints the head commit of each push (commitlint.yml) and the PR title.
set -e

# husky.sh skipped every hook when HUSKY=0. Keep that switch.
[ "${HUSKY:-}" = "0" ] && exit 0
# husky.sh sourced ~/.huskyrc, for example to put a Node version manager on PATH.
if [ -f ~/.huskyrc ]; then . ~/.huskyrc; fi

if [ -e node_modules/.bin/commitlint ]; then
  npx commitlint --edit "$1"
else
  echo "commit-msg: commitlint is not installed (run npm ci); skipping. CI lints only the head commit of each push and the PR title." >&2
fi
